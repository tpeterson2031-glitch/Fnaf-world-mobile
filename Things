
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>FNAF World Mobile</title>
<style>
* { box-sizing: border-box; }
html, body {
  margin: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #111;
  color: white;
  font-family: Arial, sans-serif;
}
body {
  display: flex;
  flex-direction: column;
}
header {
  height: 42px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 5px 10px;
  background: #222;
}
button {
  padding: 7px 12px;
  border: 0;
  border-radius: 6px;
  background: #555;
  color: white;
}
iframe {
  flex: 1;
  width: 100%;
  min-height: 0;
  border: 0;
  background: black;
}
footer {
  padding: 5px;
  text-align: center;
  font-size: 11px;
  background: #222;
  color: #bbb;
}
@media (orientation: portrait) {
  footer::after {
    content: " Rotate your phone sideways for the best view.";
  }
}
</style>
</head>
<body>
<header>
  <strong>FNAF World</strong>
  <button onclick="document.documentElement.requestFullscreen?.()">
    Fullscreen
  </button>
</header>

<iframe
  src="https://irv77.github.io/hd_fnaf/w/"
  title="FNAF World"
  allowfullscreen>
</iframe>

<footer>Mobile landscape layout</footer>
</body>
</html>
